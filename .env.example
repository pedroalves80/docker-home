# Model 3 instance
TM3_DB_USER=tm3user
TM3_DB_PASS=model3pass
TM3_DB_NAME=teslamate_model3
TM3_ENCRYPTION_KEY=changeme_model3

# Model Y instance
TMY_DB_USER=tmyuser
TMY_DB_PASS=modelypass
TMY_DB_NAME=teslamate_modely
TMY_ENCRYPTION_KEY=changeme_modely

# Grafana
GF_SECURITY_ADMIN_PASSWORD=yourpasswordhere

# Authelia (SSO & 2FA)
# Generate secrets with: openssl rand -hex 32
AUTHELIA_SESSION_SECRET=changeme_session_secret_64chars
AUTHELIA_STORAGE_ENCRYPTION_KEY=changeme_storage_key_64chars

# Vaultwarden (Password Manager)
VAULTWARDEN_ADMIN_TOKEN=SuperLongRandomStringHereAtLeast64Chars!@#2026
# Example generation command on your host: openssl rand -base64 48

# Diun (Docker Image Update Notifier)
DIUN_TELEGRAM_TOKEN=changeme_telegram_bot_token
DIUN_TELEGRAM_CHAT_ID=changeme_telegram_chat_id

# Deye solar inverter MQTT bridge
DEYE_MQTT_LOG_LEVEL=INFO
DEYE_LOGGER_IP_ADDRESS=10.10.99.229
DEYE_LOGGER_SERIAL_NUMBER=3583619085
DEYE_LOGGER_PROTOCOL=tcp
DEYE_LOGGER_PORT=8899
DEYE_METRIC_GROUPS=deye_sg04lp3,deye_sg04lp3_battery,deye_sg04lp3_ups,deye_sg04lp3_generator
DEYE_DATA_READ_INTERVAL=30
DEYE_MQTT_TOPIC_PREFIX=deye

# Solar dashboard Home Assistant API proxy token
# Generate in Home Assistant: Profile > Long-lived access tokens
SOLAR_DASHBOARD_HA_TOKEN=changeme_home_assistant_long_lived_token

# Tailscale
TS_AUTHKEY=changeme

# PriceBuddy (Price Tracking)
PRICEBUDDY_DB_NAME=pricebuddy
PRICEBUDDY_DB_USER=pricebuddy
PRICEBUDDY_DB_PASS=changeme_pricebuddy
PRICEBUDDY_DB_ROOT_PASS=changeme_root
PRICEBUDDY_ADMIN_EMAIL=admin@example.com
PRICEBUDDY_ADMIN_PASS=changeme_admin
PRICEBUDDY_APP_KEY=changeme_app_key_base64

# Wishlist
WISHLIST_TOKEN_TIME=72
WISHLIST_DEFAULT_CURRENCY=EUR
WISHLIST_MAX_IMAGE_SIZE=10000000
WISHLIST_LOG_LEVEL=info

# Paperless-ngx
# Generate secrets with: openssl rand -hex 32
PAPERLESS_DB_NAME=paperless
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASS=changeme_paperless_db
PAPERLESS_SECRET_KEY=changeme_paperless_secret_key
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=changeme_paperless_admin
PAPERLESS_ADMIN_MAIL=admin@home.lan
PAPERLESS_OCR_LANGUAGE=por+eng
PAPERLESS_OCR_LANGUAGES=por
PAPERLESS_OCR_MODE=skip
PAPERLESS_OCR_CLEAN=none
PAPERLESS_TASK_WORKERS=1
PAPERLESS_THREADS_PER_WORKER=1
PAPERLESS_WEBSERVER_WORKERS=1
PAPERLESS_ENABLE_NLTK=false
PAPERLESS_USERMAP_UID=1000
PAPERLESS_USERMAP_GID=1000

# Apprise API (Notification Gateway)
# No configuration required - uses defaults
# Access at: https://apprise.home.lan
# For PriceBuddy: Create a config key at https://apprise.home.lan and add your Telegram URL:
#   tgram://YOUR_BOT_TOKEN/YOUR_CHAT_ID

# Global
TZ=Europe/Lisbon
